---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Must-Haves" description="Products Tom actually uses and stands behind. No sponsorships.">
<style>
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
  }
  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .page-tag {
    display: inline-block;
    background: var(--rust);
    color: white;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 2px;
    margin-bottom: 0.75rem;
  }
  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 700;
    color: var(--brown);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }
  .page-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-style: italic;
    font-family: 'Playfair Display', serif;
  }
  .empty-state {
    background: var(--warm-white);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 3rem 2rem;
    text-align: center;
  }
  .empty-icon { font-size: 2.5rem; margin-bottom: 1rem; display: block; }
  .empty-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    color: var(--brown);
    margin-bottom: 0.5rem;
  }
  .empty-text { font-size: 0.9rem; color: var(--text-muted); font-style: italic; }
</style>

<main>
  <div class="page-header">
    <span class="page-tag">Must-Haves</span>
    <h1 class="page-title">Must-Haves</h1>
    <p class="page-subtitle">Things I actually own, actually use, and would actually buy again. No sponsored posts, ever.</p>
  </div>

  <div class="empty-state">
    <span class="empty-icon">⭐</span>
    <p class="empty-title">Must-Haves coming soon</p>
    <p class="empty-text">Tom is making his list. Check back shortly.</p>
  </div>
</main>
</Layout>
