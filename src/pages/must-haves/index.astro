---
import Layout from '../../layouts/Layout.astro';

const items = [
  {
    slug: 'ninja-auto-iq-blender',
    title: 'The Only Blender That Survives My Daily Routine: Ninja Auto iQ Review',
    tag: 'Must-Have · Kitchen',
    description: 'If you\'re constantly making protein shakes or smoothies, a cheap blender is going to burn out. This one hasn\'t.',
    rating: '5 / 5',
  },
  {
    slug: 'ninja-speedi',
    title: 'One Air Fryer to Rule Them All: Ninja Speedi Review',
    tag: 'Must-Have · Kitchen',
    description: 'It looks like it belongs in an industrial kitchen. But it genuinely replaces several appliances and earns a permanent spot on the counter.',
    rating: '4.13 / 5',
  },
  {
    slug: 'rollerblade-casters',
    title: 'Stop Using the Garbage Casters That Came With Your Chair',
    tag: 'Must-Have · Office',
    description: 'No tools. No hassle. Pop the old ones out, pop these in, and wonder why every chair doesn\'t ship with these.',
    rating: '5.00 / 5',
  },
];
---
<Layout title="Must-Haves" description="Products Tom actually uses and stands behind.">
<style>
  main { max-width: 860px; margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
  .page-header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
  .page-tag { display: inline-block; background: var(--rust); color: white; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; padding: 0.25rem 0.65rem; border-radius: 2px; margin-bottom: 0.75rem; }
  .page-title { font-family: 'Fraunces', serif; font-size: clamp(1.8rem, 5vw, 2.8rem); font-weight: 700; color: var(--brown); line-height: 1.15; margin-bottom: 0.5rem; }
  .page-subtitle { font-size: 0.95rem; color: var(--text-muted); font-style: italic; font-family: 'Fraunces', serif; }
  .item-list { display: flex; flex-direction: column; gap: 1rem; }
  .item-card { background: var(--warm-white); border: 1px solid var(--border); border-radius: 2px; padding: 1.5rem 1.75rem; text-decoration: none; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s; box-shadow: 0 2px 8px rgba(59,42,26,0.04); }
  .item-card:hover { border-color: var(--tan); box-shadow: 0 4px 16px rgba(59,42,26,0.08); transform: translateY(-1px); }
  .item-info { flex: 1; }
  .item-tag { display: inline-block; font-size: 0.63rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--rust); margin-bottom: 0.4rem; }
  .item-title { font-family: 'Fraunces', serif; font-size: 1.1rem; font-weight: 700; color: var(--brown); margin-bottom: 0.3rem; line-height: 1.3; }
  .item-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; }
  .item-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; flex-shrink: 0; }
  .item-rating { font-family: 'Fraunces', serif; font-size: 0.9rem; font-weight: 700; color: var(--rust); white-space: nowrap; }
  .item-arrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  @media (max-width: 560px) { .item-card { flex-direction: column; align-items: flex-start; } .item-meta { align-items: flex-start; flex-direction: row; } }
</style>

<main>
  <div class="page-header">
    <span class="page-tag">Must-Haves</span>
    <h1 class="page-title">Must-Haves</h1>
    <p class="page-subtitle">Things I actually own, actually use, and would actually buy again.</p>
  </div>

  <div class="item-list">
    {items.map(item => (
      <a href={`/must-haves/${item.slug}`} class="item-card">
        <div class="item-info">
          <span class="item-tag">{item.tag}</span>
          <p class="item-title">{item.title}</p>
          <p class="item-desc">{item.description}</p>
        </div>
        <div class="item-meta">
          {item.rating && <span class="item-rating">★ {item.rating}</span>}
          <span class="item-arrow">Read →</span>
        </div>
      </a>
    ))}
  </div>
</main>
</Layout>
