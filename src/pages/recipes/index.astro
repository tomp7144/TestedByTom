---
import Layout from '../../layouts/Layout.astro';

const recipes = [
  {
    title: "TikTok Nachos",
    slug: "tiktok-nachos",
    description: "Two pans. Zero mess. Instant nachos.",
    score: "4.75",
    stars: "★★★★★",
  },
  {
    title: "Strawberry Banana Smoothie",
    slug: "strawberry-banana-smoothie",
    description: "Thick, creamy, and stupid easy. The Ninja earns its counter space.",
    score: "4.75",
    stars: "★★★★★",
  },
  {
    title: "Vanilla Ice Cream",
    slug: "vanilla-ice-cream",
    description: "Four ingredients. No churn. Dangerously good.",
    score: "4.63",
    stars: "★★★★★",
  },
  {
    title: "Chocolate Ice Cream",
    slug: "chocolate-ice-cream",
    description: "Things this simple shouldn't taste this good.",
    score: "5.00",
    stars: "★★★★★",
  },
  {
    title: "Mini Chocolate Chip Muffins",
    slug: "mini-chocolate-chip-muffins",
    description: "A solid first try. My kids aren't letting go of Entenmann's just yet.",
    score: "3.75",
    stars: "★★★★☆",
  },
  {
    title: "Chicken Bites",
    slug: "chicken-bites",
    description: "Air fried, kid-approved, and on the table in under 30 minutes.",
    score: "3.75",
    stars: "★★★★☆",
  },
  {
    title: "Ninja Blender Ice Cream",
    slug: "ninja-blender-ice-cream",
    description: "Testing now...",
    score: null,
    stars: null,
  },
  {
    title: "Vanilla Coffee Creamer",
    slug: "vanilla-coffee-creamer",
    description: "Took a few tries to nail the technique. Worth it — this actually replaces your store-bought creamer.",
    score: "4.67",
    stars: "★★★★★",
  },
];
---

<Layout title="Recipes | Tested by Tom">
  <section class="listing-page">

    <div class="listing-header">
      <span class="category-tag">Recipes</span>
      <h1>Recipes</h1>
      <p class="listing-subtitle">Everything I've made, rated honestly. If it was bad, I'll tell you.</p>
    </div>

    <div class="recipe-grid">
      {recipes.map((recipe) => (
        <a href={`/recipes/${recipe.slug}`} class="recipe-card">
          <div class="card-body">
            <h2 class="card-title">{recipe.title}</h2>
            <p class="card-description">{recipe.description}</p>
          </div>
          <div class="card-footer">
            {recipe.score ? (
              <div class="card-rating">
                <span class="card-stars">{recipe.stars}</span>
                <span class="card-score">{recipe.score}/5</span>
              </div>
            ) : (
              <span class="card-testing">Testing now...</span>
            )}
            <span class="card-arrow">→</span>
          </div>
        </a>
      ))}
    </div>

  </section>
</Layout>

<style>
  .listing-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    font-family: 'Lato', sans-serif;
    color: var(--brown);
  }

  .listing-header {
    margin-bottom: 2.5rem;
  }

  .category-tag {
    display: inline-block;
    background: var(--rust);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .listing-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    color: var(--brown);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .listing-subtitle {
    font-size: 1.05rem;
    color: var(--tan);
    font-style: italic;
    margin: 0;
  }

  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .recipe-card {
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--brown);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .recipe-card:hover {
    border-color: var(--rust);
    box-shadow: 0 4px 16px rgba(59, 42, 26, 0.08);
  }

  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--brown);
  }

  .card-description {
    font-size: 0.9rem;
    color: var(--tan);
    margin: 0 0 1.25rem;
    line-height: 1.55;
    font-style: italic;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
  }

  .card-rating {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .card-stars {
    color: var(--rust);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
  }

  .card-score {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--brown);
  }

  .card-testing {
    font-size: 0.85rem;
    color: var(--tan);
    font-style: italic;
  }

  .card-arrow {
    color: var(--rust);
    font-size: 1rem;
    transition: transform 0.2s;
  }

  .recipe-card:hover .card-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 480px) {
    .recipe-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
