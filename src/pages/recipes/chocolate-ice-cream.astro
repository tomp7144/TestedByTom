---
import Layout from '../../layouts/Layout.astro';

const ratings = {
  taste: 5,
  easeOfPrep: 5,
  cookingEase: null,
  cleanup: 5,
};

const ratingLabels = {
  taste: "Taste",
  easeOfPrep: "Ease of Prep",
  cookingEase: "Cooking Ease",
  cleanup: "Cleanup",
};

const ratedValues = Object.values(ratings).filter(v => v !== null) as number[];
const finalScore = (ratedValues.reduce((a, b) => a + b, 0) / ratedValues.length).toFixed(2);

function stars(rating: number | null) {
  if (rating === null) return "N/A";
  return "★".repeat(rating) + "☆".repeat(5 - rating);
}
---

<Layout title="Chocolate Ice Cream | Tested by Tom">
  <article class="recipe-page">

    <div class="recipe-hero">
      <div class="hero-text">
        <span class="category-tag">Recipe</span>
        <h1>Chocolate Ice Cream</h1>
        <p class="subtitle">Things this simple shouldn't taste so good. Seriously, wow.</p>
        <div class="final-score-badge">
          <span class="score-number">{finalScore}</span>
          <span class="score-out-of">/5</span>
          <span class="score-stars">★★★★★</span>
        </div>
      </div>
    </div>

    <div class="recipe-body">

      <section class="recipe-intro">
        <p>
          This ice cream is so smooth, rich, and creamy I don't need to buy ice cream ever again. Maybe I'm getting a little ahead of myself — but this is good. It doesn't take a lot to have enough either. Similar to the vanilla ice cream, because it's so rich and heavy you're satisfied after just a few bites. A perfect post-dinner dessert.
        </p>
        <p>
          Just make sure you have something to put it in before you make it.
        </p>
      </section>

      <div class="affiliate-callout">
        <p>
          <strong>Uses the Ninja Auto-iQ Blender.</strong> This recipe only works as well as it does because of that machine.
          <a href="https://amzn.to/4w9oRVo" target="_blank" rel="nofollow sponsored noopener">→ Grab it on Amazon</a>
        </p>
        <p class="ftc-disclosure">Affiliate link — I earn a small commission at no cost to you.</p>
      </div>

      <div class="two-col">

        <section class="ingredients">
          <h2>Ingredients</h2>
          <ul>
            <li>2 cups heavy cream (35%)</li>
            <li>14 oz sweetened condensed milk (1 can)</li>
            <li>3 tablespoons unsweetened cocoa powder</li>
            <li>1 teaspoon vanilla extract</li>
          </ul>
        </section>

        <section class="steps">
          <h2>Steps</h2>
          <ol>
            <li>Add heavy cream to your Ninja blender and blend until thick and fluffy.</li>
            <li>Add sweetened condensed milk, cocoa powder, and vanilla extract. Blend until fully combined and smooth.</li>
            <li>Pour into a container and freeze for 6–8 hours before serving.</li>
          </ol>
          <p class="step-note">No cooking, no ice cream maker. Just blend, freeze, and wait.</p>
        </section>

      </div>

      <section class="ratings">
        <h2>Honest Rating</h2>
        <div class="rating-grid">
          {Object.entries(ratings).map(([key, value]) => (
            <div class={`rating-row ${value === null ? 'na' : ''}`}>
              <span class="rating-label">{ratingLabels[key as keyof typeof ratingLabels]}</span>
              <span class="rating-stars">{stars(value)}</span>
              <span class="rating-value">{value !== null ? `${value}/5` : 'N/A'}</span>
            </div>
          ))}
        </div>
        <div class="final-score">
          <span class="final-label">Final Score</span>
          <span class="final-number">{finalScore} / 5</span>
        </div>
        <p class="verdict">
          A perfect score across the board. It's two ingredients beyond vanilla ice cream — heavy cream, cacao, sugar — and it somehow hits harder. Rich, creamy, no cooking, no ice cream maker, barely any cleanup. This one earned it.
        </p>
      </section>

    </div>
  </article>
</Layout>

<style>
  .recipe-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    font-family: 'Lato', sans-serif;
    color: var(--brown);
  }

  .recipe-hero {
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .category-tag {
    display: inline-block;
    background: var(--rust);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 3px;
    margin-bottom: 1rem;
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2.25rem;
    color: var(--brown);
    margin: 0 0 0.5rem;
  }

  .subtitle {
    font-size: 1.1rem;
    color: #6b5340;
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .final-score-badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    background: var(--brown);
    color: var(--cream);
    padding: 0.5rem 1rem;
    border-radius: 6px;
  }

  .score-number {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .score-out-of {
    font-size: 1rem;
    opacity: 0.8;
    margin-right: 0.5rem;
  }

  .score-stars {
    color: var(--tan);
    font-size: 1rem;
  }

  .recipe-intro {
    margin-bottom: 2rem;
    line-height: 1.75;
    font-size: 1.05rem;
  }

  .recipe-intro p + p {
    margin-top: 1rem;
  }

  .affiliate-callout {
    background: var(--tan-light);
    border-left: 4px solid var(--rust);
    padding: 1rem 1.25rem;
    border-radius: 0 6px 6px 0;
    margin-bottom: 2.5rem;
  }

  .affiliate-callout p {
    margin: 0;
    font-size: 0.95rem;
  }

  .affiliate-callout a {
    color: var(--rust);
    font-weight: 700;
    margin-left: 0.5rem;
    text-decoration: none;
  }

  .affiliate-callout a:hover {
    text-decoration: underline;
  }

  .ftc-disclosure {
    margin-top: 0.4rem !important;
    font-size: 0.8rem !important;
    color: #7a6050;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 600px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }

  h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    color: var(--brown);
    border-bottom: 2px solid var(--border);
    padding-bottom: 0.4rem;
    margin-bottom: 1rem;
  }

  .ingredients ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ingredients li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }

  .ingredient-note {
    font-size: 0.8rem;
    color: #7a6050;
    font-style: italic;
    margin-top: 0.75rem;
  }

  .steps ol {
    padding-left: 1.25rem;
    margin: 0;
  }

  .steps li {
    padding: 0.4rem 0;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .step-note {
    font-size: 0.85rem;
    color: #7a6050;
    font-style: italic;
    margin-top: 0.75rem;
  }

  .ratings {
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem;
  }

  .rating-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .rating-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .rating-row.na {
    opacity: 0.45;
  }

  .rating-label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .rating-stars {
    color: var(--tan);
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .rating-value {
    font-size: 0.9rem;
    color: #6b5340;
    min-width: 2.5rem;
    text-align: right;
  }

  .final-score {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--brown);
    color: var(--cream);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    margin-bottom: 1.25rem;
  }

  .final-label {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .final-number {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .verdict {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #5a4030;
    font-style: italic;
    margin: 0;
  }
</style>
