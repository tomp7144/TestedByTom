---
const { title = "TestedByTom", description = "If it was bad, I'll tell you." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — TestedByTom</title>
  <meta name="description" content={description} />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;1,9..144,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #fdf6ec;
      --warm-white: #fffdf9;
      --brown: #3b2a1a;
      --rust: #c0562a;
      --tan: #c9a87c;
      --tan-light: #e8d5b7;
      --green: #4a6741;
      --green-light: #d4e4d2;
      --text: #2c1f10;
      --text-muted: #7a6050;
      --border: #e0cdb5;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Lato', sans-serif;
      background-color: var(--cream);
      color: var(--text);
      line-height: 1.6;
    }

    /* ── SITE HEADER ── */
    .site-header {
      background-color: var(--brown);
      color: var(--cream);
      text-align: center;
      padding: 3rem 1.5rem 2.5rem;
      position: relative;
      overflow: hidden;
    }
    .site-header::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        45deg, transparent, transparent 40px,
        rgba(255,255,255,0.02) 40px, rgba(255,255,255,0.02) 80px
      );
    }
    .site-header a {
      text-decoration: none;
      color: inherit;
    }
    .site-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--tan);
      margin-bottom: 0.4rem;
      position: relative;
    }
    .site-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(2rem, 6vw, 3.5rem);
      font-weight: 700;
      line-height: 1.1;
      position: relative;
    }
    .site-tagline {
      margin-top: 0.6rem;
      font-size: 0.9rem;
      color: var(--tan-light);
      font-style: italic;
      font-family: 'Fraunces', serif;
      position: relative;
    }
    .header-rule {
      width: 50px;
      height: 2px;
      background: var(--rust);
      margin: 1rem auto 0;
      position: relative;
    }

    /* ── NAV ── */
    nav {
      background: var(--warm-white);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      overflow-x: auto;
    }
    nav a {
      display: block;
      padding: 0.85rem 1.1rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      text-decoration: none;
      white-space: nowrap;
      border-bottom: 2px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }
    nav a:hover,
    nav a.active { color: var(--rust); border-bottom-color: var(--rust); }

    /* ── FOOTER ── */
    footer {
      text-align: center;
      padding: 2rem 1rem;
      font-size: 0.78rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
      font-style: italic;
      font-family: 'Fraunces', serif;
    }
  </style>
</head>
<body>

  <header class="site-header">
    <a href="/">
      <p class="site-label">TestedByTom</p>
      <h1 class="site-title">Tested By Tom</h1>
      <p class="site-tagline">If it was bad, I'll tell you.</p>
      <div class="header-rule"></div>
    </a>
  </header>

  <nav>
    <a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>Home</a>
    <a href="/recipes" class={Astro.url.pathname.startsWith('/recipes') ? 'active' : ''}>Recipes</a>
    <a href="/must-haves" class={Astro.url.pathname.startsWith('/must-haves') ? 'active' : ''}>Must-Haves</a>
    <a href="/household-tips" class={Astro.url.pathname.startsWith('/household-tips') ? 'active' : ''}>Household Tips</a>
    <a href="/projects" class={Astro.url.pathname.startsWith('/projects') ? 'active' : ''}>Projects</a>
  </nav>

  <slot />

  <footer>
    <p>TestedByTom — if it was bad, I'll tell you.</p>
  </footer>

</body>
</html>
