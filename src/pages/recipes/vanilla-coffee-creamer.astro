---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Natural Bliss Vanilla Coffee Creamer" description="Homemade vanilla coffee creamer with no cooking required. Just mix and refrigerate.">
<style>
  main { max-width: 860px; margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
  .back-link { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); text-decoration: none; margin-bottom: 1.75rem; transition: color 0.2s; }
  .back-link:hover { color: var(--rust); }
  .recipe-card { background: var(--warm-white); border: 1px solid var(--border); border-radius: 2px; overflow: hidden; box-shadow: 0 2px 12px rgba(59,42,26,0.06); }
  .recipe-header { background: var(--brown); color: var(--cream); padding: 2rem 2.25rem 1.75rem; }
  .recipe-tag { display: inline-block; background: var(--rust); color: white; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; padding: 0.25rem 0.65rem; border-radius: 2px; margin-bottom: 0.75rem; }
  .recipe-header h1 { font-family: 'Fraunces', serif; font-size: clamp(1.4rem, 4vw, 2rem); font-weight: 700; line-height: 1.2; margin-bottom: 0.6rem; }
  .recipe-header p { font-size: 0.9rem; color: var(--tan-light); font-style: italic; font-family: 'Fraunces', serif; }
  .recipe-body { padding: 2rem 2.25rem; }
  .servings-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  .servings-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .servings-control { display: flex; align-items: center; gap: 0.5rem; background: var(--cream); border: 1px solid var(--border); border-radius: 2px; padding: 0.25rem 0.5rem; }
  .servings-btn { background: none; border: none; cursor: pointer; font-size: 1.1rem; color: var(--rust); font-weight: 700; padding: 0 0.3rem; line-height: 1; }
  .servings-btn:hover { color: var(--brown); }
  .servings-count { font-weight: 700; font-size: 1rem; min-width: 1.5rem; text-align: center; color: var(--brown); }
  .recipe-columns { display: grid; grid-template-columns: 1fr 1.6fr; gap: 2.5rem; }
  @media (max-width: 600px) { .recipe-columns { grid-template-columns: 1fr; } .recipe-body { padding: 1.5rem 1.25rem; } .recipe-header { padding: 1.5rem 1.25rem; } }
  .section-title { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rust); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.6rem; }
  .section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .ingredients-list { list-style: none; }
  .ingredients-list li { display: flex; align-items: baseline; gap: 0.5rem; padding: 0.45rem 0; border-bottom: 1px solid var(--tan-light); font-size: 0.9rem; }
  .ingredients-list li:last-child { border-bottom: none; }
  .ing-amount { font-weight: 700; color: var(--rust); min-width: 3rem; font-size: 0.85rem; white-space: nowrap; }
  .ing-name { color: var(--text); }
  .steps-list { list-style: none; }
  .step { display: flex; gap: 1rem; margin-bottom: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--tan-light); }
  .step:last-child { border-bottom: none; margin-bottom: 0; }
  .step-num { background: var(--brown); color: var(--cream); font-family: 'Fraunces', serif; font-size: 0.85rem; font-weight: 700; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 0.1rem; }
  .step-title { font-weight: 700; font-size: 0.85rem; color: var(--brown); margin-bottom: 0.2rem; }
  .step-text { font-size: 0.88rem; color: var(--text); line-height: 1.55; }
  .timer-btn { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.5rem; background: var(--green-light); border: 1px solid var(--green); color: var(--green); border-radius: 2px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.3rem 0.65rem; cursor: pointer; transition: background 0.15s, color 0.15s; }
  .timer-btn:hover { background: var(--green); color: white; }
  .timer-btn.running { background: var(--rust); border-color: var(--rust); color: white; }
  .recipe-notes { margin-top: 1.75rem; padding: 1rem 1.25rem; background: var(--cream); border-left: 3px solid var(--tan); border-radius: 0 2px 2px 0; }

  .recipe-rating { padding: 1.5rem 2.25rem; background: var(--cream); border-top: 1px solid var(--border); }
  .rating-title { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rust); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.6rem; }
  .rating-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .rating-grid { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.25rem; }
  .rating-row { display: flex; align-items: center; gap: 0.75rem; font-size: 0.875rem; }
  .rating-label { min-width: 120px; color: var(--text-muted); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .rating-stars { color: var(--rust); letter-spacing: 0.05em; font-size: 0.85rem; }
  .rating-stars.na { color: var(--border); }
  .rating-score { font-weight: 700; color: var(--brown); font-size: 0.85rem; }
  .rating-score.na { color: var(--text-muted); font-weight: 400; }
  .rating-final { display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1rem; background: var(--brown); border-radius: 2px; margin-bottom: 1.25rem; }
  .final-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--tan-light); }
  .final-score { font-family: 'Fraunces', serif; font-size: 1.4rem; font-weight: 700; color: var(--cream); }
  .rating-verdict .verdict-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rust); margin-bottom: 0.5rem; }
  .rating-verdict p { font-size: 0.9rem; color: var(--text); line-height: 1.6; }
  .recipe-notes .notes-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem; }
  .recipe-notes p { font-size: 0.875rem; color: var(--text-muted); font-style: italic; }
</style>

<main>
  <a href="/recipes" class="back-link">← All Recipes</a>
  <div class="recipe-card">
    <div class="recipe-header">
      <span class="recipe-tag">Drinks</span>
      <h1>Natural Bliss Vanilla Coffee Creamer</h1>
      <p>Homemade vanilla coffee creamer with no cooking required. Just mix and refrigerate!</p>
    </div>
    <div class="recipe-body">
      <div class="servings-row">
        <span class="servings-label">Servings</span>
        <div class="servings-control">
          <button class="servings-btn" onclick="changeServings(-1)">−</button>
          <span class="servings-count" id="servings-count">4</span>
          <button class="servings-btn" onclick="changeServings(1)">+</button>
        </div>
      </div>
      <div class="recipe-columns">
        <section>
          <h2 class="section-title">Ingredients</h2>
          <ul class="ingredients-list" id="ingredients-list"></ul>
        </section>
        <section>
          <h2 class="section-title">Instructions</h2>
          <ol class="steps-list">
            <li class="step"><span class="step-num">1</span><div><div class="step-title">Mix the Sugar into the Milk</div><p class="step-text">Add the whole milk and sugar to a jar or pitcher. Stir well until the sugar is fully dissolved. Do this by hand — do not use a blender or you will whip the cream into whipped cream.</p></div></li>
            <li class="step"><span class="step-num">2</span><div><div class="step-title">Add the Cream and Vanilla</div><p class="step-text">Gently stir in the heavy whipping cream and vanilla extract until everything is combined. Keep it gentle — no whipping.</p>
              <button class="timer-btn" id="timer-btn-1" onclick="startTimer('timer-btn-1','timer-display-1',30)"><span class="icon">⏱</span> <span id="timer-display-1">0:30</span></button></div></li>
            <li class="step"><span class="step-num">3</span><div><div class="step-title">Pour and Refrigerate</div><p class="step-text">Pour into a glass jar or sealed bottle and refrigerate. Ready to use right away!</p></div></li>
          </ol>
          <div class="recipe-notes">
            <p class="notes-label">Notes</p>
            <p><strong>DO NOT WHIP!</strong> Using a blender at high speed will whip the cream and milk into whipped cream. Stir the sugar into the milk by hand first, then gently mix in the heavy cream. Whole milk gives the richest result, but 2% works for a lighter creamer. Keeps in the fridge for up to 2 weeks in a sealed jar. Give it a shake before each use as it may separate slightly. Want it sweeter? Bump up to ⅓ cup sugar.</p>
          </div>
        </section>
      </div>
    </div>
  </div>

  <div class="recipe-rating">
    <p class="rating-title">Honest Rating</p>
    <div class="rating-grid">
      <div class="rating-row">
        <span class="rating-label">Taste</span>
        <span class="rating-stars">★★★★☆</span>
        <span class="rating-score">4/5</span>
      </div>
      <div class="rating-row">
        <span class="rating-label">Ease of Prep</span>
        <span class="rating-stars">★★★★★</span>
        <span class="rating-score">5/5</span>
      </div>
      <div class="rating-row">
        <span class="rating-label">Cooking Ease</span>
        <span class="rating-stars na">—</span>
        <span class="rating-score na">N/A</span>
      </div>
      <div class="rating-row">
        <span class="rating-label">Cleanup</span>
        <span class="rating-stars">★★★★★</span>
        <span class="rating-score">5/5</span>
      </div>
    </div>
    <div class="rating-final">
      <span class="final-label">Final Score</span>
      <span class="final-score">4.67 / 5</span>
    </div>
    <div class="rating-verdict">
      <p class="verdict-label">Verdict</p>
      <p>Took me a few attempts to figure out but the secret is simple: don't go nuts on it. Get a 40+ oz container, add the milk and sugar first and swish — not shake — until the sugar dissolves. Then gently pour in the heavy cream and vanilla and swish again. If you shake it hard you end up with watery milk and a separate glob of whipped cream floating on top. (The whipped cream tastes incredible, but that's not what we're making.) Get the technique right and this genuinely replaces your store-bought creamer. Cleanup is measuring cups and that's it.</p>
    </div>
  </div>
</main>

<script>
  const baseServings = 4; let currentServings = 4;
  const ingredients = [
    { amount: 1.5,  unit: 'cup', name: 'whole milk' },
    { amount: 1.5,  unit: 'cup', name: 'heavy whipping cream' },
    { amount: 0.25, unit: 'cup', name: 'sugar (adjust to taste)' },
    { amount: 1,    unit: 'tsp', name: 'vanilla extract' },
  ];
  function formatAmount(val) { if (val === 0) return '—'; const whole = Math.floor(val); const frac = val - whole; const fracs = { 0.25: '¼', 0.5: '½', 0.75: '¾', 0.333: '⅓', 0.667: '⅔' }; const fracStr = fracs[Math.round(frac * 1000) / 1000] || (frac > 0 ? frac.toFixed(2) : ''); return whole > 0 ? `${whole}${fracStr}` : fracStr || val.toString(); }
  function renderIngredients() { const ratio = currentServings / baseServings; document.getElementById('ingredients-list').innerHTML = ingredients.map(ing => { const scaled = ing.amount * ratio; const amt = formatAmount(Math.round(scaled * 4) / 4); return `<li><span class="ing-amount">${amt}${ing.unit ? ' ' + ing.unit : ''}</span><span class="ing-name">${ing.name}</span></li>`; }).join(''); }
  function changeServings(delta) { currentServings = Math.max(1, currentServings + delta); document.getElementById('servings-count').textContent = currentServings; renderIngredients(); }
  const timers = {};
  function startTimer(btnId, displayId, seconds) { const btn = document.getElementById(btnId); const display = document.getElementById(displayId); if (timers[btnId]) { clearInterval(timers[btnId].interval); btn.classList.remove('running'); btn.querySelector('.icon').textContent = '⏱'; display.textContent = formatTime(timers[btnId].total); delete timers[btnId]; return; } let remaining = seconds; btn.classList.add('running'); btn.querySelector('.icon').textContent = '⏹'; const interval = setInterval(() => { remaining--; display.textContent = formatTime(remaining); if (remaining <= 0) { clearInterval(interval); btn.classList.remove('running'); btn.querySelector('.icon').textContent = '✅'; display.textContent = 'Done!'; delete timers[btnId]; } }, 1000); timers[btnId] = { interval, total: seconds }; }
  function formatTime(s) { const h = Math.floor(s / 3600); const m = Math.floor((s % 3600) / 60); const sec = s % 60; if (h > 0) return `${h}:${m.toString().padStart(2,'0')}:${sec.toString().padStart(2,'0')}`; return `${m}:${sec.toString().padStart(2,'0')}`; }
  renderIngredients();
</script>
</Layout>

