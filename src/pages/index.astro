---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home">
<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }

  /* ── BIO ── */
  .bio {
    display: grid;
    grid-template-columns: 3px 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 3.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }
  .bio-rule {
    width: 3px;
    height: 100%;
    background: var(--rust);
    border-radius: 2px;
  }
  .bio-content {}
  .bio-greeting {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 0.75rem;
  }
  .bio-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    line-height: 1.7;
    color: var(--brown);
    font-style: italic;
  }

  /* ── CATEGORY CARDS ── */
  .section-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  .category-card {
    background: var(--warm-white);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 1.75rem;
    text-decoration: none;
    display: block;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    box-shadow: 0 2px 8px rgba(59,42,26,0.05);
    position: relative;
    overflow: hidden;
  }
  .category-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--rust);
    transform: scaleX(0);
    transition: transform 0.2s;
  }
  .category-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(59,42,26,0.1);
    border-color: var(--tan);
  }
  .category-card:hover::before {
    transform: scaleX(1);
  }
  .card-icon {
    font-size: 1.75rem;
    margin-bottom: 0.85rem;
    display: block;
  }
  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--brown);
    margin-bottom: 0.4rem;
  }
  .card-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .card-arrow {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rust);
  }

  /* ── WHAT IS THIS ── */
  .about-box {
    background: var(--brown);
    color: var(--cream);
    border-radius: 2px;
    padding: 2rem 2.25rem;
  }
  .about-box-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tan);
    margin-bottom: 0.85rem;
  }
  .about-box p {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 0.98rem;
    color: var(--tan-light);
    line-height: 1.75;
  }

  @media (max-width: 500px) {
    .bio { grid-template-columns: 3px 1fr; gap: 1rem; }
  }
</style>

<main>

  <div class="bio">
    <div class="bio-rule"></div>
    <div class="bio-content">
      <p class="bio-greeting">Who is Tom?</p>
      <p class="bio-text">I'm Tom. I used to work way too much. Now I'm a stay-at-home dad and I want to keep track of what I've tried — so I built my own website. Here's what I've tried and what I thought.</p>
    </div>
  </div>

  <p class="section-label">Browse by Category</p>
  <div class="category-grid">
    <a href="/recipes" class="category-card">
      <span class="card-icon">🍳</span>
      <p class="card-title">Recipes</p>
      <p class="card-desc">Real food, honest ratings. If it tasted great but made me feel terrible, you'll know.</p>
      <span class="card-arrow">Browse recipes →</span>
    </a>
    <a href="/must-haves" class="category-card">
      <span class="card-icon">⭐</span>
      <p class="card-title">Must-Haves</p>
      <p class="card-desc">Products I actually use and stand behind. No sponsorships, no fluff.</p>
      <span class="card-arrow">See must-haves →</span>
    </a>
    <a href="/household-tips" class="category-card">
      <span class="card-icon">🏠</span>
      <p class="card-title">Household Tips</p>
      <p class="card-desc">Little things I've figured out around the house. Some obvious, some not.</p>
      <span class="card-arrow">Read tips →</span>
    </a>
  </div>

  <div class="about-box">
    <p class="about-box-label">What is this site?</p>
    <p>No sponsored posts. No affiliate pressure. No five-star reviews because someone sent me a free product. I'm a stay-at-home dad who tests things — recipes, products, household hacks — and writes down what actually happened. If it was great, I'll tell you. If it was bad, I'll tell you that too.</p>
  </div>

</main>
</Layout>
